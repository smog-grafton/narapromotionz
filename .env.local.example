NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_NAME=Nara Promotionz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=UGX
NEXT_PUBLIC_ENABLE_PAYWALL=true
NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=true
NEXT_PUBLIC_ENABLE_COUPONS=true
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
NEXT_PUBLIC_ENABLE_LIVE_BANNER=true
NEXT_IMAGE_ALLOW_LOCAL_IP=true
NEXT_IMAGE_UNOPTIMIZED=true

